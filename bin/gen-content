#!/usr/bin/env bash
# Full content batch via the Anthropic API, detached from the harness.
# Keys come from the gitignored .env; logs and PID go to run/.
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p run
set -a; . ./.env; set +a
export LLM_PROVIDER="${LLM_PROVIDER:-anthropic}"
cd tools/content
nohup dart run bin/generate.dart --jobs "${JOBS:-6}" "$@" > ../../run/gen-content.log 2>&1 &
echo $! > ../../run/gen-content.pid
disown
echo "started pid $(cat ../../run/gen-content.pid), log run/gen-content.log"
