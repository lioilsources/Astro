{
  "version": 1,
  "about": "Pravidla elekční astrologie (plán 10.7). Váhy a vzorec: docs/scoring.md, oddíl Elekce. Kód pravidla jen vyhodnocuje.",
  "thresholds": {"strong": 8, "good": 4, "weak": 1},
  "rules": [
    {"id": "moon_void", "kind": "exclude", "weight": 0, "when": "moon_void", "text": "election/rule/moon_void",
     "about": "Měsíc bez aspektu: od posledního hlavního aspektu ve znamení do vstupu do dalšího znamení. Jediné tvrdé pravidlo, takové okno se nevrací."},

    {"id": "moon_waxing", "kind": "plus", "weight": 2, "when": "moon_waxing", "text": "election/rule/moon_waxing",
     "about": "Dorůstající Měsíc: od novu do úplňku, věc podle tradice roste."},
    {"id": "moon_next_venus", "kind": "plus", "weight": 3, "when": "moon_next_aspect", "params": {"bodies": ["venus"]}, "text": "election/rule/moon_next_venus",
     "about": "Příští aspekt Měsíce ve znamení míří na Venuši, menší dobrodějku."},
    {"id": "moon_next_jupiter", "kind": "plus", "weight": 3, "when": "moon_next_aspect", "params": {"bodies": ["jupiter"]}, "text": "election/rule/moon_next_jupiter",
     "about": "Příští aspekt Měsíce ve znamení míří na Jupiter, větší dobroděj."},
    {"id": "venus_angle", "kind": "plus", "weight": 2, "when": "on_angle", "params": {"body": "venus", "orb": 5}, "text": "election/rule/venus_angle",
     "about": "Venuše do 5° od ascendentu, descendentu, MC nebo IC."},
    {"id": "jupiter_angle", "kind": "plus", "weight": 2, "when": "on_angle", "params": {"body": "jupiter", "orb": 5}, "text": "election/rule/jupiter_angle",
     "about": "Jupiter do 5° od ascendentu, descendentu, MC nebo IC."},
    {"id": "asc_ruler_dignified", "kind": "plus", "weight": 3, "when": "asc_ruler_dignified", "text": "election/rule/asc_ruler_dignified",
     "about": "Tradiční vládce ascendentu ve vlastním znamení nebo v povýšení a přímý."},
    {"id": "hour_of_intent", "kind": "plus", "weight": 2, "when": "hour_of_intent_planet", "text": "election/rule/hour_of_intent",
     "about": "Planetární hodina patří planetě záměru."},
    {"id": "intent_planet_dignified", "kind": "plus", "weight": 2, "when": "intent_planet_state", "params": {"state": "dignified"}, "text": "election/rule/intent_planet_dignified",
     "about": "Planeta záměru ve vlastním znamení nebo v povýšení."},
    {"id": "benefic_in_intent_house", "kind": "plus", "weight": 1, "when": "in_intent_house", "params": {"bodies": ["venus", "jupiter"]}, "text": "election/rule/benefic_in_intent_house",
     "about": "Venuše nebo Jupiter v domě záměru."},
    {"id": "personal_moon_harmonious", "kind": "plus", "weight": 2, "layer": "personal", "when": "moon_to_natal",
     "params": {"targets": ["sun", "moon", "asc"], "aspects": ["conjunction", "sextile", "trine"], "orb": 3}, "text": "election/rule/personal_moon_harmonious",
     "about": "Měsíc okna v konjunkci, sextilu nebo trigonu s natálním Sluncem, Měsícem nebo ascendentem (orb 3°)."},
    {"id": "personal_calm_day", "kind": "plus", "weight": 1, "layer": "personal", "when": "day_tension", "params": {"max": 0}, "text": "election/rule/personal_calm_day",
     "about": "V den okna nemá osobní horoskop žádný napěťový tranzit (skóre napětí 0)."},

    {"id": "moon_next_mars_hard", "kind": "minus", "weight": 3, "when": "moon_next_aspect", "params": {"bodies": ["mars"], "aspects": ["square", "opposition"]}, "text": "election/rule/moon_next_mars_hard",
     "about": "Příští aspekt Měsíce je kvadrát nebo opozice k Marsu."},
    {"id": "moon_next_saturn_hard", "kind": "minus", "weight": 3, "when": "moon_next_aspect", "params": {"bodies": ["saturn"], "aspects": ["square", "opposition"]}, "text": "election/rule/moon_next_saturn_hard",
     "about": "Příští aspekt Měsíce je kvadrát nebo opozice k Saturnu."},
    {"id": "mars_angle", "kind": "minus", "weight": 2, "when": "on_angle", "params": {"body": "mars", "orb": 5}, "text": "election/rule/mars_angle",
     "about": "Mars do 5° od ascendentu, descendentu, MC nebo IC."},
    {"id": "saturn_angle", "kind": "minus", "weight": 2, "when": "on_angle", "params": {"body": "saturn", "orb": 5}, "text": "election/rule/saturn_angle",
     "about": "Saturn do 5° od ascendentu, descendentu, MC nebo IC."},
    {"id": "intent_planet_retrograde", "kind": "minus", "weight": 2, "when": "intent_planet_state", "params": {"state": "retrograde"}, "text": "election/rule/intent_planet_retrograde",
     "about": "Planeta záměru je retrográdní."},
    {"id": "intent_planet_fall", "kind": "minus", "weight": 2, "when": "intent_planet_state", "params": {"state": "fall"}, "text": "election/rule/intent_planet_fall",
     "about": "Planeta záměru je v pádu."},
    {"id": "intent_planet_detriment", "kind": "minus", "weight": 2, "when": "intent_planet_state", "params": {"state": "detriment"}, "text": "election/rule/intent_planet_detriment",
     "about": "Planeta záměru je ve zničení (ve znamení naproti svému sídlu)."},
    {"id": "asc_ruler_bad_house", "kind": "minus", "weight": 2, "when": "asc_ruler_in_house", "params": {"houses": [6, 8, 12]}, "text": "election/rule/asc_ruler_bad_house",
     "about": "Vládce ascendentu v 6., 8. nebo 12. domě."},
    {"id": "asc_ruler_retrograde", "kind": "minus", "weight": 1, "when": "asc_ruler_retrograde", "text": "election/rule/asc_ruler_retrograde",
     "about": "Vládce ascendentu je retrográdní."},
    {"id": "eclipse", "kind": "minus", "weight": 3, "when": "eclipse_near", "params": {"days": 1}, "text": "election/rule/eclipse",
     "about": "Den zatmění Slunce nebo Měsíce, den před ním a den po něm (místní kalendářní dny)."},
    {"id": "via_combusta", "kind": "minus", "weight": 2, "when": "moon_between", "params": {"from": 195, "to": 225}, "text": "election/rule/via_combusta",
     "about": "Měsíc ve spálené cestě, od 15° Vah do 15° Štíra."},
    {"id": "malefic_in_intent_house", "kind": "minus", "weight": 1, "when": "in_intent_house", "params": {"bodies": ["mars", "saturn"]}, "text": "election/rule/malefic_in_intent_house",
     "about": "Mars nebo Saturn v domě záměru."},
    {"id": "personal_moon_tense", "kind": "minus", "weight": 2, "layer": "personal", "when": "moon_to_natal",
     "params": {"targets": ["sun", "moon", "asc"], "aspects": ["square", "opposition"], "orb": 3}, "text": "election/rule/personal_moon_tense",
     "about": "Měsíc okna v kvadrátu nebo opozici k natálnímu Slunci, Měsíci nebo ascendentu (orb 3°)."},
    {"id": "personal_tension_high", "kind": "minus", "weight": 2, "layer": "personal", "when": "day_tension", "params": {"min": 60}, "text": "election/rule/personal_tension_high",
     "about": "Skóre napětí tranzitů v den okna je 60 a víc."}
  ]
}
